# Connexion PostgreSQL — en production, Railway l'injecte automatiquement
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/centre_saoufi?schema=public"

# Clé de signature des sessions — générer une chaîne aléatoire longue en production
SESSION_SECRET="change_this_secret_in_production"

# Environnement : development | production
NODE_ENV=development

# Port d'écoute du serveur backend
PORT=3000

# ─── Notifications email (rappels J-1) ───────────────────────────────────────
# Adresses destinataires séparées par une virgule
REMINDER_EMAILS=destinataire1@example.com,destinataire2@example.com

# Configuration SMTP (exemple Gmail — utiliser un mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
